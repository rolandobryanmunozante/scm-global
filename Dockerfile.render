# syntax=docker/dockerfile:1
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.9.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json backend/package.json
COPY frontend/package.json frontend/package.json

FROM base AS build
RUN --mount=type=cache,id=scm-render-pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile
COPY backend backend
COPY frontend frontend
RUN pnpm --filter @scm/backend build && pnpm --filter @scm/frontend build

FROM base AS runtime
ENV NODE_ENV=production
ENV FRONTEND_DIST_PATH=/app/frontend/dist
LABEL org.opencontainers.image.source="https://github.com/rolandobryanmunozante/scm-global"
RUN apk add --no-cache postgresql-client
RUN --mount=type=cache,id=scm-render-pnpm-store,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile --prod --filter @scm/backend...
COPY --from=build /app/backend/dist /app/backend/dist
COPY --from=build /app/frontend/dist /app/frontend/dist
COPY database/migrations /migrations
COPY database/migrate.sh /migrate.sh
COPY scripts/simulate-telemetry.mjs /app/scripts/simulate-telemetry.mjs
COPY scripts/render-entrypoint.sh /render-entrypoint.sh
RUN chmod +x /migrate.sh /render-entrypoint.sh
WORKDIR /app/backend
EXPOSE 10000
CMD ["/render-entrypoint.sh"]
